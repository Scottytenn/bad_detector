[Unit]
Description=Bad Detector camera stream
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=scotty
WorkingDirectory=/home/scotty/bad_detector
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/usr/bin/v4l2-ctl -d /dev/video0 --set-fmt-video=width=640,height=480,pixelformat=MJPG --set-parm=120
ExecStart=/home/scotty/bad_detector/venv/bin/python /home/scotty/bad_detector/stream_server.py --device /dev/video0 --width 640 --height 480 --fps 120 --fourcc MJPG --jpeg-quality 50
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
